{
  "_comment": "Controlled vocabulary that maps free-text call reasons (from transcript LLM classification AND Zendesk fields) onto a small set of canonical categories so rankings are not fragmented by phrasing. Each category lists 'aliases' (case-insensitive substrings); the first category whose alias is found in a reason becomes its canonical label. Reasons matching nothing fall through to 'fallback_canonical'. Refresh the mapping table after editing: python scripts/build_reason_taxonomy.py",
  "fallback_canonical": "Other / Uncategorized",
  "match_mode": "substring",
  "categories": [
    {
      "canonical": "Order status",
      "aliases": ["order status", "where is my order", "track order", "tracking", "shipment status", "delivery status", "check status", "status of order", "eta"]
    },
    {
